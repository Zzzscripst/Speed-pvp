-- FUNÇÃO WEBHOOK
local function sendWebhook(tipo)
	execucoes = execucoes + 1
	
	local data = {
		["content"] = "**🚀 Script Executado!**\n👤 Usuário: "..player.Name..
		"\n📌 Ação: "..tipo..
		"\n🔢 Vezes usadas: "..execucoes
	}

	if req then
		req({
			Url = webhook,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = HttpService:JSONEncode(data)
		})
	end
end

